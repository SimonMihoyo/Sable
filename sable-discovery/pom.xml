<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>me.kirara</groupId>
		<artifactId>sable</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>sable-discovery</artifactId>
	<name>sable-discovery</name>
	<description>数据资产发现 — 数据源管理、Schema扫描、敏感数据识别</description>

	<dependencies>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
		</dependency>

		<!--
			接口级鉴权的注解来源（@PreAuthorize），与 sable-system 的声明方式一致。

			scope 取 provided：库模块只需要编译期看得见这个注解，真正的鉴权实现
			（SecurityFilterChain、方法级鉴权管理器）由启动模块通过
			spring-boot-starter-security 提供。provided 不传递依赖，
			因此不会把 Spring Security 带给下游模块的运行时。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>me.kirara</groupId>
		<artifactId>sable</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>sable-system</artifactId>
	<name>sable-system</name>
	<description>系统管理 — 用户、角色、租户、配置</description>

	<dependencies>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
		</dependency>

		<!--
			接口级鉴权的注解来源（@PreAuthorize / @PostAuthorize）。

			scope 取 provided，与上面的 starter-web 同理：库模块只需要"编译期看得见"这个注解，
			真正的实现（SecurityFilterChain、过滤器、鉴权管理器）由启动模块引入。
			provided **不传递依赖**，所以不会把 Spring Security 泄漏给下游模块的运行时。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- JWT 签发 / 校验 —— 认证由本模块的 AuthService 与启动模块的过滤器完成 -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			密码哈希（BCrypt）—— 只用 crypto 组件，不引入完整的 Spring Security 运行时。

			它早已在依赖树上，因此后来为鉴权引入 spring-boot-starter-security 时，
			core / crypto / web 落在同一条版本线上（由 boot 父 pom 统一管理），不存在冲突。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>

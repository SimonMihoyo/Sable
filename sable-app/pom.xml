<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>me.kirara</groupId>
		<artifactId>sable</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>sable-app</artifactId>
	<name>sable-app</name>
	<description>启动模块 — Spring Boot Application 入口</description>

	<dependencies>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-system</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-discovery</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-classify</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-audit</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-assessment</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-alert</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-report</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-sdk</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			参数校验实现（Hibernate Validator）。
			各库模块以 provided 声明 starter-validation 仅为编译可见，
			真正的实现必须由启动模块引入，否则 @Valid / @NotBlank 全部失效。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			接口文档（OpenAPI 3 + Swagger UI）。
			由团队确认后引入，用途是让前端不必只靠设计文档猜接口：
			Swagger UI 会按真实代码生成规范，参数与字段以实现为准。
			只在启动模块引入；库模块不需要它，也不该为了写注解而引入。
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			数据库迁移（Flyway）。版本不在此声明 —— 由 Spring Boot 父 pom 统一管理
			（Boot 3.3.13 → Flyway 10.10.0），跟着 Boot 升级即可，不要钉死版本号。

			⚠️ flyway-database-postgresql 是必需的，不是可选项：
			Flyway 10 把各数据库的支持拆成了独立模块，flyway-core 本身不再内置
			PostgreSQL 方言，只引 core 会在启动时报
			"Unsupported Database: PostgreSQL 16.x"。
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>me.kirara</groupId>
		<artifactId>sable</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>sable-app</artifactId>
	<name>sable-app</name>
	<description>启动模块 — Spring Boot Application 入口</description>

	<dependencies>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-system</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-discovery</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-classify</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-audit</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-assessment</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-alert</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-report</artifactId>
		</dependency>
		<dependency>
			<groupId>me.kirara</groupId>
			<artifactId>sable-sdk</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!--
			参数校验实现（Hibernate Validator）。
			各库模块以 provided 声明 starter-validation 仅为编译可见，
			真正的实现必须由启动模块引入，否则 @Valid / @NotBlank 全部失效。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!--
			接口文档（OpenAPI 3 + Swagger UI）。
			由团队确认后引入，用途是让前端不必只靠设计文档猜接口：
			Swagger UI 会按真实代码生成规范，参数与字段以实现为准。
			只在启动模块引入；库模块不需要它，也不该为了写注解而引入。
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<!--
			接口级鉴权（Spring Security）。

			引入它只为"鉴权"这一半：认证仍由本项目的 JwtAuthenticationFilter 自己做
			（它要给出 40001/40002/40003 这些细分错误码，Security 的内置入口表达不了），
			"某个接口需要哪个权限码"则交给 @PreAuthorize。

			⚠️ 装配处有四件必须小心的事（过滤器挂载点、CORS 不能重复、过滤器顺序、
			响应契约必须保住），全部写在 me.kirara.sable.config.SecurityConfig 的类注释里 ——
			改鉴权前先读那一段，不要照着网上的默认配置改。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			数据库迁移（Flyway）。版本不在此声明 —— 由 Spring Boot 父 pom 统一管理
			（Boot 3.3.13 → Flyway 10.10.0），跟着 Boot 升级即可，不要钉死版本号。

			⚠️ flyway-database-postgresql 是必需的，不是可选项：
			Flyway 10 把各数据库的支持拆成了独立模块，flyway-core 本身不再内置
			PostgreSQL 方言，只引 core 会在启动时报
			"Unsupported Database: PostgreSQL 16.x"。
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
			MySQL 驱动（对应 sable-discovery 的 MySqlDialect）。

			只加在启动模块、scope=runtime：库模块不需要编译期依赖，扫描与探测都在
			JDBC 抽象之上；版本由 Spring Boot 父 pom 管理（8.3.0），不要钉死。
			⚠️ 许可证注意：mysql-connector-j 是 GPLv2 + FOSS 例外，商业 SaaS 若对此有顾虑，
			可改用 MariaDB Connector/J（LGPL 2.1，兼容 MySQL 协议），驱动类名/URL 头都要随之调整。
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Testcontainers：MySQL 方言的元数据行为只有真库能验证（schema 语义、注释、
			类型名都与 PostgreSQL 不同）。本地没有 Docker 时这些用例会跳过（disabledWithoutDocker），
			GitHub Actions 的 runner 自带 Docker，CI 上会真正执行。
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
